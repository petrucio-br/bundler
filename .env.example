# Copy to .env.local and fill in real values. Do not commit .env.local.

# --- Public base URL ---
# Local: http://localhost:3000
# Production: https://bundler.games
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Supabase ---
# Get from your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
# Server-only. Used for admin operations bypassing RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# --- Steam Web API ---
# Get from https://steamcommunity.com/dev/apikey (free, instant).
STEAM_WEB_API_KEY=YOUR_STEAM_API_KEY

# --- Session secret ---
# 32+ chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me_with_a_long_random_string_at_least_32_chars

# --- Cron secret ---
# Used to authenticate the weekly follower-refresh cron at /api/cron/refresh-followers.
# Vercel auto-sets this in its hosted environment when cron is enabled, so locally just generate any random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace_me_with_a_random_string

# --- Email (Resend) ---
# For match notification emails. Free tier is 3000/month, no credit card.
# 1. Sign up at https://resend.com
# 2. Verify the bundler.games domain via DNS records (Cloudflare-managed)
# 3. Get the API key from Resend dashboard
# Leave RESEND_API_KEY blank for local dev to skip sending (calls will log+no-op).
# While the domain is being verified, set EMAIL_FROM to "Bundler <onboarding@resend.dev>".
RESEND_API_KEY=
EMAIL_FROM=Bundler <noreply@bundler.games>

# --- Feature flags ---
# Show "share Bundler" growth nudges across the app (empty Browse callout,
# Yes-pending tab callout, sidebar share slot, post-save preferences nudge,
# match notification email PS line). Off by default - flip to "true" once the
# userbase is big enough that the prompts don't read awkward to the first
# handful of beta users.
NEXT_PUBLIC_SHOW_GROWTH_NUDGES=false
